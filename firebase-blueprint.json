{
  "entities": {
    "LoginEvent": {
      "title": "LoginEvent",
      "description": "Non-sensitive visitor login audit event recorded without any password or credential fields.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 4,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique event document ID"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the signed-in visitor"
        },
        "visitorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Visitor display name"
        },
        "visitorEmail": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 120,
          "description": "Visitor email address"
        },
        "loginMethod": {
          "type": "string",
          "enum": ["google", "email_signup", "email_signin", "quick_demo"],
          "maxLength": 24,
          "description": "Authentication method used"
        },
        "gymVibe": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "description": "Selected workout music vibe"
        },
        "deviceLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Client platform and browser summary"
        },
        "loggedInAtIso": {
          "type": "string",
          "format": "date-time",
          "minLength": 10,
          "maxLength": 40,
          "description": "ISO-8601 timestamp string for display"
        },
        "loggedInAt": {
          "type": "string",
          "format": "date-time",
          "description": "Firestore server timestamp verified against request.time"
        }
      },
      "required": [
        "id",
        "uid",
        "visitorName",
        "visitorEmail",
        "loginMethod",
        "gymVibe",
        "deviceLabel",
        "loggedInAtIso",
        "loggedInAt"
      ]
    },
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Non-PII listener profile fields stored at users/{userId}.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "gymVibe": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "gymVibe", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII document storing user email under users/{userId}/private/info.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 120
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "updatedAt"]
    },
    "TrackMetadataOverride": {
      "title": "TrackMetadataOverride",
      "description": "User-customized track metadata and custom organization tags under users/{userId}/track_metadata/{trackId}.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "trackId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "artist": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "album": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "genre": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "releaseYear": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "language": {
          "type": "string",
          "minLength": 0,
          "maxLength": 24
        },
        "bpm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "linerNotes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 600
        },
        "tags": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        },
        "updatedAtIso": {
          "type": "string",
          "format": "date-time",
          "minLength": 10,
          "maxLength": 40
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "trackId",
        "title",
        "artist",
        "album",
        "genre",
        "releaseYear",
        "language",
        "bpm",
        "linerNotes",
        "tags",
        "updatedAtIso",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/login_events/{eventId}": {
      "schema": {
        "$ref": "#/entities/LoginEvent"
      },
      "description": "Append-only sanitized login activity visible to the website owner (rohitrrathod1958@gmail.com)."
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserPublicProfile"
      },
      "description": "Publicly scoped non-PII listener profile attributes."
    },
    "/users/{userId}/private/info": {
      "schema": {
        "$ref": "#/entities/UserPrivateInfo"
      },
      "description": "Strictly isolated PII document for the authenticated user and site owner."
    },
    "/users/{userId}/track_metadata/{trackId}": {
      "schema": {
        "$ref": "#/entities/TrackMetadataOverride"
      },
      "description": "Per-user track metadata edits and custom organization tags."
    }
  }
}
